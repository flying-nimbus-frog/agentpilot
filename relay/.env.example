# ===== AgentPilot 中继服务器配置模板 =====
# 使用方法: cp .env.example .env 然后填入真实值
# 注意: .env 已加入 .gitignore，不会提交到仓库

# ---------- 必填 ----------

# JWT 签名密钥（务必改成随机长字符串！）
# 生成: openssl rand -hex 32
RELAY_JWT_SECRET=change-me-please

# ---------- 可选 ----------

# 服务端口（默认 8000）
RELAY_PORT=8000

# 数据库文件路径（默认 relay/relay.db）
#RELAY_DB=/data/relay.db

# 浏览器/Web 调试用 CORS（1=开 0=关；原生手机 App 不受影响）
RELAY_CORS=1

# ---------- 邮件（邮箱验证 / 密码找回）----------
# 不配置时：验证/重置链接只打印到日志（仅开发用）

# SMTP 服务器（QQ邮箱: smtp.qq.com, 企业邮箱: smtp.exmail.qq.com）
#RELAY_SMTP_HOST=smtp.qq.com
#RELAY_SMTP_PORT=465
#RELAY_SMTP_USER=you@qq.com
#RELAY_SMTP_PASS=your-smtp-auth-code
#RELAY_MAIL_FROM=you@qq.com

# 邮件链接前缀（对外访问地址，用于生成验证/重置链接）
#RELAY_PUBLIC_BASE=https://relay.zhileai.net
