# OpenCode Remote 中继 · nginx 反代配置
#
# 使用步骤（两阶段）：
#   1. 先按本文件（443 段已注释）启用 80 端口
#   2. certbot 申请证书
#   3. 解开下方 443 段注释，reload
#
# 前置：DNS 添加 A 记录 ocrelay → 服务器IP

server {
    listen 80;
    server_name ocrelay.zhileai.net;

    # 证书申请/续期用（webroot 方式）
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

